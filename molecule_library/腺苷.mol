# 分子构建脚本（由 oc_io 生成）
# 警告：加载本文件会执行其中的代码，请勿运行来源不明的文件。
import organic_chemistry as oc

molecule = oc.Molecule(name='腺苷')

a0 = oc.Atom('c', molecule)
a1 = oc.Atom('c', molecule)
a2 = oc.Atom('c', molecule)
a3 = oc.Atom('c', molecule)
a4 = oc.Atom('o', molecule)
a5 = oc.Atom('c', molecule)
a6 = oc.Atom('c', molecule)
a7 = oc.Atom('c', molecule)
a8 = oc.Atom('o', molecule)
a9 = oc.Atom('n', molecule)
a10 = oc.Atom('c', molecule)
a11 = oc.Atom('n', molecule)
a12 = oc.Atom('c', molecule)
a13 = oc.Atom('c', molecule)
a14 = oc.Atom('c', molecule)
a15 = oc.Atom('n', molecule)
a16 = oc.Atom('c', molecule)
a17 = oc.Atom('n', molecule)
a18 = oc.Atom('n', molecule)

oc.add_bond(a0, a1)
oc.add_bond(a0, a2)
oc.add_bond(a2, a3)
oc.add_bond(a3, a4)
oc.add_bond(a1, a4)
oc.add_bond(a0, a5)
oc.add_bond(a2, a6)
oc.add_bond(a3, a7)
oc.add_bond(a7, a8)
oc.add_bond(a1, a9)
oc.add_bond(a9, a10)
oc.add_bond(a10, a11, order=2)
oc.add_bond(a9, a12)
oc.add_bond(a11, a13)
oc.add_bond(a13, a12)
oc.add_bond(a12, a14, order=2)
oc.add_bond(a13, a15, order=2)
oc.add_bond(a15, a16)
oc.add_bond(a16, a17, order=2)
oc.add_bond(a14, a18)
oc.add_bond(a14, a17)


molecule.validate()

if __name__ == "__main__":
    print(molecule)
