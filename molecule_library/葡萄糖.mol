# 分子构建脚本（由 oc_io 生成）
# 警告：加载本文件会执行其中的代码，请勿运行来源不明的文件。
import organic_chemistry as oc

molecule = oc.Molecule(name='葡萄糖')

a0 = oc.Atom('c', molecule)
a1 = oc.Atom('c', molecule)
a2 = oc.Atom('c', molecule)
a3 = oc.Atom('c', molecule)
a4 = oc.Atom('c', molecule)
a5 = oc.Atom('c', molecule)
a6 = oc.Atom('o', molecule)
a7 = oc.Atom('o', molecule)
a8 = oc.Atom('o', molecule)
a9 = oc.Atom('o', molecule)
a10 = oc.Atom('o', molecule)
a11 = oc.Atom('o', molecule)

oc.add_bond(a0, a1)
oc.add_bond(a0, a2)
oc.add_bond(a1, a3)
oc.add_bond(a3, a4)
oc.add_bond(a4, a5)
oc.add_bond(a2, a6)
oc.add_bond(a1, a7)
oc.add_bond(a3, a8)
oc.add_bond(a4, a9)
oc.add_bond(a5, a10, order=2)
oc.add_bond(a0, a11)


molecule.validate()

if __name__ == "__main__":
    print(molecule)
