import organic_chemistry as oc

molecule = oc.Molecule(name='环己烷')

a0 = oc.Atom('c', molecule)
a1 = oc.Atom('c', molecule)
a2 = oc.Atom('c', molecule)
a3 = oc.Atom('c', molecule)
a4 = oc.Atom('c', molecule)
a5 = oc.Atom('c', molecule)

oc.add_bond(a0, a1)
oc.add_bond(a2, a3)
oc.add_bond(a0, a2)
oc.add_bond(a1, a4)
oc.add_bond(a4, a5)
oc.add_bond(a3, a5)


molecule.validate()

if __name__ == "__main__":
    print(molecule)
